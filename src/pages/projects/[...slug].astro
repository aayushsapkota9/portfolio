---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Card from '../../components/ui/Card.astro';
import PillButton from '../../components/ui/PillButton.astro';
import SiteFooter from '../../components/SiteFooter.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((x) => x.id === p.id);
const next = all[(idx + 1) % all.length];

const statusLabel: Record<string, string> = {
  live: 'Live',
  'in-progress': 'In progress',
  archived: 'Archived',
  private: 'Private',
};
---

<Base title={`${d.title} — Aayush Sapkota`} description={d.tagline}>
  <main class="px-4 pb-10 xs:px-10">
    <article class="mx-auto max-w-6xl pt-16 xs:pt-24">
      <a
        href="/projects"
        class="font-satoshi text-sm font-bold uppercase tracking-wide text-muted transition-colors hover:text-accent"
        >← All projects</a
      >

      <div
        class="mt-6 flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-muted"
      >
        <span class={d.status === 'live' ? 'text-emerald-600' : 'text-muted'}>
          {statusLabel[d.status]}
        </span>
        <span class="text-line">/</span><span>{d.kind}</span>
        <span class="text-line">/</span><span>{d.year}</span>
        <span class="text-line">/</span><span>{d.role}</span>
      </div>

      <h2
        class="mt-4 font-display text-[42px] font-medium leading-[1.03] tracking-tighter text-ink xs:text-[68px]"
      >
        {d.title}
      </h2>
      <p class="mt-5 max-w-2xl text-xl leading-8">{d.tagline}</p>

      {
        d.stack.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-1.5">
            {d.stack.map((s) => (
              <li class="rounded-md border border-line/80 px-2.5 py-1.5 font-mono text-[11px] uppercase leading-none tracking-[0.08em] text-muted">
                {s}
              </li>
            ))}
          </ul>
        )
      }

      {
        (d.url || d.repo) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {d.url && (
              <PillButton href={d.url} external>
                Visit site
              </PillButton>
            )}
            {d.repo && (
              <PillButton href={d.repo} external>
                Source
              </PillButton>
            )}
          </div>
        )
      }

      <!-- hero poster -->
      <Card class="mt-12 overflow-hidden p-3">
        <Image
          src={d.cover}
          alt={`${d.title} preview`}
          widths={[720, 1200, 1800]}
          sizes="(max-width: 1024px) 100vw, 1100px"
          class="w-full rounded-3xl"
          loading="eager"
        />
      </Card>

      <!-- write-up -->
      <Card class="mt-8 px-6 py-8 xs:px-12 xs:py-10">
        <div class="prose-body mx-auto max-w-2xl space-y-6">
          <Content />
        </div>
      </Card>

      <!-- gallery -->
      {
        d.gallery.length > 0 && (
          <section class="mt-16">
            <div class="mb-6 font-mono text-[11px] uppercase tracking-[0.1em] text-accent">
              Screens
            </div>
            <div class="flex flex-col gap-8">
              {d.gallery.map((g) => (
                <figure>
                  <Card class="overflow-hidden p-2.5">
                    <div class="overflow-hidden rounded-[20px] border border-line/60">
                      <Image
                        src={g.src}
                        alt={g.caption}
                        widths={[720, 1200, 1600]}
                        sizes="(max-width: 1024px) 100vw, 1100px"
                        class="w-full object-cover object-top max-h-[70vh]"
                        loading="lazy"
                      />
                    </div>
                  </Card>
                  <figcaption class="mt-3 px-1 font-mono text-xs leading-relaxed text-muted">
                    {g.caption}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <!-- next -->
      <a href={`/projects/${next.id}`} class="group/next mt-16 block">
        <Card
          hover
          class="flex items-center justify-between gap-6 px-6 py-6 xs:px-10 xs:py-8"
        >
          <div>
            <div class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted">
              Next project
            </div>
            <div class="mt-2 text-3xl font-medium leading-none text-ink">
              {next.data.title}
            </div>
          </div>
          <svg
            class="h-6 w-6 shrink-0 text-faint transition-transform group-hover/next:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <path d="M5 12h14m-6-7 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </Card>
      </a>
    </article>

    <div class="mx-auto max-w-8xl"><SiteFooter /></div>
  </main>
</Base>

<style is:global>
  .prose-body h2 {
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-top: 2.5rem;
  }
  .prose-body h2:first-child {
    margin-top: 0;
  }
  .prose-body p {
    font-size: 1.125rem;
    line-height: 2rem;
  }
  .prose-body ul {
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--color-muted);
    font-size: 1.125rem;
    line-height: 2rem;
  }
  .prose-body li::marker {
    color: var(--color-accent);
  }
  .prose-body strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-body em {
    font-style: italic;
  }
  .prose-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
