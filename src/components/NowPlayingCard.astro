---
import Card from './ui/Card.astro';
import { nowPlaying } from '../data/site';
---

<Card
  hover
  class="h-full w-full flex-col items-end justify-end overflow-visible px-7 py-6 text-right"
>
  <div
    class="mb-4 w-full border-b border-hairline pb-4 font-satoshi text-sm font-bold uppercase tracking-wide text-ink"
  >
    Recent favorite
  </div>

  <div
    data-nowplaying
    class="flex max-w-full items-center justify-end space-x-4 leading-snug"
  >
    <a
      href={nowPlaying.href}
      target="_blank"
      rel="noopener noreferrer"
      class="group min-w-0 text-right active:translate-y-[1px]"
    >
      <div
        class="truncate text-lg font-medium text-ink transition-colors group-hover:text-accent"
      >
        {nowPlaying.track}
      </div>
      <div class="truncate text-base font-medium text-muted">{nowPlaying.artist}</div>
    </a>

    <!-- Sibling of the link, never nested inside it: a button inside an anchor
         is invalid HTML and swallows the click on some browsers. -->
    <button
      type="button"
      data-toggle
      aria-pressed="false"
      aria-label={`Play a preview of ${nowPlaying.track} by ${nowPlaying.artist}`}
      class="group/play relative grid h-12 w-12 shrink-0 cursor-pointer place-items-center rounded-full border border-line bg-white transition-colors duration-300 hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2 active:translate-y-[1px] data-[state=playing]:border-accent"
    >
      <!-- expanding ring, only while playing -->
      <span
        data-ring
        class="pointer-events-none absolute inset-0 rounded-full border border-accent opacity-0"
        aria-hidden="true"></span>

      <!-- The three states are stacked and crossfaded, so swapping them can
           never nudge the layout. -->
      <span
        data-state-icon="paused"
        class="absolute inset-0 grid place-items-center transition-all duration-300 ease-out"
      >
        <svg
          class="h-4 w-4 translate-x-[1px] text-accent transition-transform duration-300 group-hover/play:scale-110"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M4.5 2.6a.9.9 0 0 1 1.36-.77l7 5.4a.9.9 0 0 1 0 1.54l-7 5.4A.9.9 0 0 1 4.5 13.4V2.6Z"></path>
        </svg>
      </span>

      <span
        data-state-icon="loading"
        class="absolute inset-0 grid scale-75 place-items-center opacity-0 transition-all duration-300 ease-out"
        aria-hidden="true"
      >
        <span class="flex items-center gap-[3px]">
          <i class="dot" style="animation-delay:0ms"></i>
          <i class="dot" style="animation-delay:160ms"></i>
          <i class="dot" style="animation-delay:320ms"></i>
        </span>
      </span>

      <span
        data-state-icon="playing"
        class="absolute inset-0 grid scale-75 place-items-center opacity-0 transition-all duration-300 ease-out"
        aria-hidden="true"
      >
        <span class="flex h-4 items-center gap-[3px]">
          <i class="bar" style="--h:9px;animation-delay:0ms"></i>
          <i class="bar" style="--h:16px;animation-delay:220ms"></i>
          <i class="bar" style="--h:12px;animation-delay:110ms"></i>
          <i class="bar" style="--h:7px;animation-delay:330ms"></i>
        </span>
      </span>

      <!-- sweeps once around the ring as the clip plays -->
      <svg
        data-progress
        class="pointer-events-none absolute inset-0 h-full w-full -rotate-90 opacity-0 transition-opacity duration-300"
        viewBox="0 0 48 48"
        fill="none"
        aria-hidden="true"
      >
        <circle
          cx="24"
          cy="24"
          r="23.5"
          stroke="var(--color-accent)"
          stroke-width="1.5"
          stroke-linecap="round"
          pathLength="1"
          stroke-dasharray="1"
          stroke-dashoffset="1"></circle>
      </svg>
    </button>

    <!-- preload="none" so the clip costs nothing until it is asked for -->
    <audio data-audio src={nowPlaying.preview} preload="none"></audio>
  </div>
</Card>

<script>
  document.querySelectorAll<HTMLElement>('[data-nowplaying]').forEach((root) => {
    const audio = root.querySelector<HTMLAudioElement>('[data-audio]');
    const button = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const ring = root.querySelector<HTMLElement>('[data-ring]');
    const arc = root.querySelector<SVGCircleElement>('[data-progress] circle');
    const progress = root.querySelector<SVGElement>('[data-progress]');
    if (!audio || !button) return;

    const icons = {
      paused: root.querySelector<HTMLElement>('[data-state-icon="paused"]'),
      loading: root.querySelector<HTMLElement>('[data-state-icon="loading"]'),
      playing: root.querySelector<HTMLElement>('[data-state-icon="playing"]'),
    };

    type State = keyof typeof icons;
    const render = (state: State) => {
      button.dataset.state = state;
      button.setAttribute('aria-pressed', String(state === 'playing'));
      (Object.keys(icons) as State[]).forEach((k) => {
        const el = icons[k];
        if (!el) return;
        el.classList.toggle('opacity-0', k !== state);
        el.classList.toggle('scale-75', k !== state);
      });
      ring?.classList.toggle('is-playing', state === 'playing');
      progress?.classList.toggle('opacity-0', state === 'paused');
    };

    button.addEventListener('click', () => {
      if (!audio.paused) {
        audio.pause();
        return;
      }
      // Pause any other clip first, so two cards can never overlap.
      document
        .querySelectorAll<HTMLAudioElement>('[data-audio]')
        .forEach((other) => other !== audio && other.pause());
      if (audio.readyState < 3) render('loading');
      // A rejected play() (autoplay policy, 404, decode error) must not leave
      // the button stuck mid-animation.
      audio.play().catch(() => render('paused'));
    });

    audio.addEventListener('playing', () => render('playing'));
    audio.addEventListener('waiting', () => render('loading'));
    audio.addEventListener('pause', () => render('paused'));
    audio.addEventListener('ended', () => {
      audio.currentTime = 0;
      render('paused');
    });
    audio.addEventListener('timeupdate', () => {
      if (!arc || !audio.duration) return;
      arc.setAttribute(
        'stroke-dashoffset',
        String(1 - audio.currentTime / audio.duration),
      );
    });
  });
</script>

<style>
  .bar {
    display: block;
    width: 3px;
    height: var(--h, 12px);
    border-radius: 9999px;
    background: var(--color-accent);
    animation: eq 1s ease-in-out infinite alternate;
  }
  @keyframes eq {
    from {
      transform: scaleY(0.35);
    }
    to {
      transform: scaleY(1);
    }
  }

  .dot {
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: var(--color-accent);
    animation: blink 1.05s ease-in-out infinite;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  [data-ring].is-playing {
    animation: ring 1.8s ease-out infinite;
  }
  @keyframes ring {
    0% {
      opacity: 0.45;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .dot,
    [data-ring].is-playing {
      animation: none;
    }
    .bar {
      transform: scaleY(0.7);
    }
  }
</style>
