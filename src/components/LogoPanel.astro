---
import { logos } from '../data/site';
---

<div class="relative flex h-full flex-col items-center justify-center">
  <!-- dotted backdrop -->
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full text-line"
    aria-hidden="true"
  >
    <defs>
      <pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="1.5" fill="currentColor" opacity="0.55"></circle>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#dots)"></rect>
  </svg>

  <div
    class="z-10 flex flex-1 flex-col items-center justify-center px-2 py-8 text-center xs:px-8"
  >
    <div
      class="mb-4 font-satoshi text-sm font-bold uppercase leading-snug tracking-wide text-muted xs:max-w-xs"
    >
      Sectors I've<br class="xs:hidden" />{' '}
      <span class="inline text-nowrap lg:block">shipped into</span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-6 p-4">
      {
        logos.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            title={l.name}
            class="group/icon text-muted transition-all duration-200 ease-in-out hover:scale-110 hover:text-accent active:translate-y-[1px]"
          >
            <span class="sr-only">{l.name}</span>
            <svg
              class="h-8 w-8"
              viewBox="0 0 24 24"
              fill={l.stroke ? 'none' : 'currentColor'}
              stroke={l.stroke ? 'currentColor' : undefined}
              stroke-width={l.stroke ? 2 : undefined}
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={l.path} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</div>
