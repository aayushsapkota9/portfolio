---
import { Image } from 'astro:assets';
import Card from './ui/Card.astro';

interface Props {
  title: string;
  tagline: string;
  kind: 'client' | 'product' | 'personal';
  status: 'live' | 'archived' | 'private' | 'in-progress';
  year: number;
  stack: string[];
  cover: ImageMetadata;
  gallery?: { src: ImageMetadata; caption: string }[];
  href: string;
  /** Compact = home page (no description body). */
  compact?: boolean;
}

const {
  title, tagline, kind, status, year, stack, cover, gallery = [], href, compact = false,
} = Astro.props;

// All slides: cover first, then gallery images
const slides = [{ src: cover, caption: title }, ...gallery];
const hasMultiple = slides.length > 1;

const statusTone: Record<string, string> = {
  live: 'text-emerald-600',
  'in-progress': 'text-accent',
  archived: 'text-muted',
  private: 'text-muted',
};
const statusLabel: Record<string, string> = {
  live: 'Live',
  'in-progress': 'In progress',
  archived: 'Archived',
  private: 'Private',
};
---

<a
  href={href}
  class="group/card block rounded-card focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-4"
>
  <Card
    class="relative flex h-full flex-col overflow-hidden transition-[background] duration-300 group-hover/card:fancy-card-hover"
  >
    <!-- image carousel wrapper (JS root) -->
    <div data-card-carousel>

      <!-- image + arrows -->
      <div class="relative m-3 mb-0 overflow-hidden rounded-3xl bg-white">

        <!-- scroll track -->
        <div
          class="card-track flex snap-x snap-mandatory overflow-x-auto"
          style="-ms-overflow-style: none; scrollbar-width: none; scroll-behavior: smooth;"
        >
          {slides.map((s, i) => (
            <div class="w-full shrink-0 snap-center">
              <Image
                src={s.src}
                alt={`${title} — ${s.caption}`}
                widths={[480, 800, 1200]}
                sizes="(max-width: 640px) 100vw, (max-width: 1280px) 50vw, 33vw"
                class="aspect-[16/10] w-full object-cover object-top"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
          ))}
        </div>

        {hasMultiple && (
          <>
            <!-- prev arrow (overlay on image) -->
            <button
              class="card-prev pointer-events-auto absolute left-2 top-1/2 z-10 -translate-y-1/2 grid h-8 w-8 place-items-center rounded-full bg-black/30 text-white shadow backdrop-blur-sm transition-all duration-150 hover:bg-black/50 active:scale-95"
              aria-label="Previous image"
              tabindex="-1"
              style="display:none"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M10 12 6 8l4-4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <!-- next arrow (overlay on image) -->
            <button
              class="card-next pointer-events-auto absolute right-2 top-1/2 z-10 -translate-y-1/2 grid h-8 w-8 place-items-center rounded-full bg-black/30 text-white shadow backdrop-blur-sm transition-all duration-150 hover:bg-black/50 active:scale-95"
              aria-label="Next image"
              tabindex="-1"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </>
        )}
      </div>

      <!-- dots — BELOW the image, not overlaid -->
      {hasMultiple && (
        <div class="card-dots flex justify-center gap-1.5 pb-1 pt-2.5">
          {slides.map((_, i) => (
            <span
              class="card-dot block h-1.5 w-1.5 rounded-full transition-colors duration-200"
              style={i === 0 ? 'background:var(--color-accent)' : 'background:var(--color-line)'}
            />
          ))}
        </div>
      )}
    </div>

    <div class="flex flex-grow flex-col gap-4 px-6 pb-5 pt-5">
      <!-- meta row -->
      <div
        class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-muted"
      >
        <span class={statusTone[status]}>{statusLabel[status]}</span>
        <span class="text-line">/</span>
        <span>{kind}</span>
        <span class="text-line">/</span>
        <span>{year}</span>
      </div>

      <div>
        <h3
          class="text-2xl font-medium leading-tight text-ink transition-colors group-hover/card:text-accent"
        >
          {title}
        </h3>
        {!compact && <p class="mt-2 text-base leading-7">{tagline}</p>}
      </div>

      <!-- stack chips -->
      {
        stack.length > 0 && (
          <ul class="mt-auto flex flex-wrap gap-1.5 pt-1">
            {stack.map((s) => (
              <li class="rounded-md border border-line/80 px-2 py-1 font-mono text-[10px] uppercase leading-none tracking-[0.08em] text-muted">
                {s}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Card>
</a>

<script>
  // Initialise every card carousel on the page (runs once per page load).
  // Uses DOM-relative queries so multiple cards coexist without ID conflicts.
  function initCardCarousels() {
    document.querySelectorAll<HTMLElement>('[data-card-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('.card-track')!;
      const prev  = root.querySelector<HTMLButtonElement>('.card-prev');
      const next  = root.querySelector<HTMLButtonElement>('.card-next');
      const dots  = Array.from(root.querySelectorAll<HTMLElement>('.card-dot'));
      if (!track || dots.length < 2) return;

      const items = Array.from(track.querySelectorAll<HTMLElement>(':scope > div'));
      const total = items.length;
      let current = 0;

      function paint(idx: number) {
        // dots: active = accent, inactive = line colour
        dots.forEach((d, i) => {
          d.style.background = i === idx ? 'var(--color-accent)' : 'var(--color-line)';
        });
        // arrows: hide at the boundary slides
        if (prev) prev.style.display = idx === 0         ? 'none' : 'grid';
        if (next) next.style.display = idx === total - 1 ? 'none' : 'grid';
      }

      function goTo(idx: number) {
        current = Math.max(0, Math.min(idx, total - 1));
        track.style.scrollBehavior = 'smooth';
        track.scrollLeft = items[current].offsetLeft;
        paint(current);
      }

      prev?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); goTo(current - 1); });
      next?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); goTo(current + 1); });

      // sync on native touch swipe
      let timer: ReturnType<typeof setTimeout>;
      track.addEventListener('scroll', () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          let closest = 0, minDist = Infinity;
          items.forEach((el, i) => {
            const dist = Math.abs(el.offsetLeft - track.scrollLeft);
            if (dist < minDist) { minDist = dist; closest = i; }
          });
          if (closest !== current) { current = closest; paint(current); }
        }, 60);
      });
    });
  }

  initCardCarousels();
</script>

<style>
  .card-track::-webkit-scrollbar { display: none; }
</style>
