---
import Card from "./ui/Card.astro";
import { site, bioSocials } from "../data/site";
---

<Card
  class="flex h-full flex-col justify-between gap-y-6 overflow-clip px-6 py-6 xs:px-7"
>
  <div class="z-10 space-y-5">
    <p>
      I'm a full-stack engineer who builds scalable web apps and automates the
      infrastructure they run on — most recently government platforms and
      accounting systems used across Nepal.
    </p>
    <p>
      Off the clock, I like exploring new technologies and business ideas and
      travelling.
    </p>
  </div>

  <!-- socials left · contact right, mirroring the reference footer row -->
  <!-- The card's width is not a function of viewport width — it is col-span-7
       at 1000px but col-span-4 at 1280px — so a viewport breakpoint cannot
       decide whether these two fit side by side. Wrapping does: they share a
       line when there is room and the address drops to its own line when not,
       instead of being silently cut off by the card's overflow-clip. -->
  <div
    class="z-10 flex w-full flex-wrap items-end justify-between gap-x-4 gap-y-5"
  >
    <ul class="flex items-center gap-2.5">
      {
        bioSocials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              title={s.name}
              class="grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition-all hover:scale-110 hover:border-accent hover:text-accent active:translate-y-[1px]"
            >
              <span class="sr-only">{s.name}</span>
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={s.path} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto min-w-0 text-right">
      <div
        class="mb-1.5 font-satoshi text-sm font-bold uppercase tracking-wide text-muted"
      >
        Find me at
      </div>
      <a
        href={`mailto:${site.email}`}
        class="block break-words text-base font-medium text-ink transition-colors hover:text-accent"
        >{site.email}</a
      >
    </div>
  </div>
</Card>
